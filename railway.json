{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["Dockerfile", ".dockerignore", "railway.json", "package.json", "package-lock.json", "tsconfig.json", "src/**", "scripts/serve.ts", "agent/**", "site/hooks.js", "site/rules.js"]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 0,
    "drainingSeconds": 120
  }
}
