{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "outputDirectory": "site",
  "rewrites": [
    { "source": "/data/log.jsonl", "destination": "https://agent.veluno.li/log.jsonl?tail=500" },
    { "source": "/data/ledger-head.json", "destination": "https://agent.veluno.li/ledger-head.json" },
    { "source": "/data/ledger.jsonl", "destination": "https://agent.veluno.li/ledger.jsonl" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "1" }]
    },
    {
      "source": "/metadata.json",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/veluno.png",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/card.png",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
