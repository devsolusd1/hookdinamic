# Copie para .env (que fica fora do git) e preencha. Usado por `npm run agent`.

# Onde o token vive
RPC_URL=
HOOK_PROGRAM=
MINT=
POOL=

# Caminho do arquivo de chave do agente (formato solana-keygen). Nunca dentro do repositório.
AGENT_KEYPAIR=

# Chave da API da Anthropic, lida pelo SDK
ANTHROPIC_API_KEY=

# Opcionais
AGENT_LOG=agent-log.jsonl
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# de quanto em quanto tempo ele confere se já é hora de escrever de novo, em segundos
AGENT_POLL_SECS=20
# quanto ele espera para olhar de novo quando não há regra em vigor, em segundos
# (com regra em vigor, ele espera ela acabar: cada regra dura o tempo que o sorteio deu)
AGENT_THINK_EVERY_SECS=300
# 1 = decide e mostra, sem enviar nem registrar nada
DRY_RUN=1
