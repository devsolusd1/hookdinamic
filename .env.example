# Copie para .env (que fica fora do git) e preencha. Usado por `npm run agent`.

# Onde o token vive
RPC_URL=
HOOK_PROGRAM=
MINT=
POOL=

# Caminho do arquivo de chave do agente (formato solana-keygen). Nunca dentro do repositório.
AGENT_KEYPAIR=

# Chave da API da Anthropic, lida pelo SDK
ANTHROPIC_API_KEY=

# Opcionais
AGENT_LOG=agent-log.jsonl
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# de quanto em quanto tempo ele confere o mercado, em segundos
AGENT_POLL_SECS=20
# intervalo entre duas olhadas quando o mercado está parado, em segundos
AGENT_THINK_EVERY_SECS=300
# variação do market cap, em %, que faz ele olhar na hora
AGENT_WAKE_ON_MOVE_PCT=10
# 1 = decide e registra, mas não envia nada
DRY_RUN=1
